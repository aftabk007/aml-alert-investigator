# Copy to .env and set your key. .env is in .gitignore and stays on your machine.
# Or point the runner at any file with this line: --env-file PATH (or GEMINI_ENV_FILE=PATH).
GEMINI_API_KEY=

# Optional
# Gemini model. Default: gemini-3.5-flash-lite
GEMINI_MODEL=
# low, medium or high thinking. Default: low
AGENT_EFFORT=low
